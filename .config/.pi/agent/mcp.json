{
	"mcpServers": {
		"fetch-server": {
			"type": "stdio",
			"command": "uvx",
			"args": [
				"mcp-server-fetch"
			],
			"env": {},
			"lifecycle": "keep-alive"
		},
		"burp": {
			"command": "java",
			"args": [
				"-jar",
				"/Users/zsm/CTF/tool/mcp-proxy.jar",
				"--sse-url",
				"http://127.0.0.1:9876"
			]
		},
		"idalib-mcp": {
			"command": "/Users/zsm/CTF/zsm/.venv/bin/python",
			"args": [
				"-m",
				"ida_pro_mcp.idalib_supervisor",
				"--stdio",
				"--isolated-contexts",
				"--max-workers",
				"4"
			],
			"cwd": "/Users/zsm/CTF/zsm",
			"lifecycle": "keep-alive"
		},
		"jadx-mcp-server": {
			"command": "/Users/zsm/.local/bin/uv",
			"args": [
				"--directory",
				"/Users/zsm/CTF/tool/jadx-mcp-server/",
				"run",
				"jadx_mcp_server.py"
			],
			"lifecycle": "keep-alive"
		}
	}
}
